# =============================================================================
#  Barbin — فایل کامل .env (MySQL)
# =============================================================================
#  نصب:
#    1) cp stock/documentation/env.mysql.full.example .env
#    2) php artisan key:generate
#    3) دیتابیس MySQL را بسازید: CREATE DATABASE barbin ...
#    4) php artisan migrate --seed
#    5) php artisan serve
# =============================================================================


# =============================================================================
#  بخش ۱ — اپلیکیشن اصلی (Laravel)
# =============================================================================

APP_NAME=Barbin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12


# =============================================================================
#  بخش ۲ — لاگ و خطایابی
# =============================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# هرگز deprecations نگذارید مگر کانال تعریف شده باشد
LOG_LEVEL=debug


# =============================================================================
#  بخش ۳ — دیتابیس MySQL (اصلی Barbin)
# =============================================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barbin
DB_USERNAME=root
DB_PASSWORD=

# charset / collation (معمولاً لازم نیست عوض شود)
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# اتصال یک خطی (اختیاری — اگر DB_* را خالی بگذارید)
# DB_URL=mysql://root:password@127.0.0.1:3306/barbin

# کلیدهای خارجی
# DB_FOREIGN_KEYS=true


# =============================================================================
#  بخش ۴ — نشست کاربر (Session) — ورود Filament
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# پشت Traefik/Runflare: TrustProxies در bootstrap/app.php تنظیم شده است.


# =============================================================================
#  بخش ۵ — کش (Cache)
# =============================================================================

CACHE_STORE=database
# CACHE_PREFIX=barbin_cache_


# =============================================================================
#  بخش ۶ — صف کارها (Queue) — import / PDF / ارسال SMS
# =============================================================================

QUEUE_CONNECTION=database
# DB_QUEUE_TABLE=jobs
# DB_QUEUE_CONNECTION=

# بعد از پروداکشن، در یک ترمینال جدا:
#   php artisan queue:work --tries=3 --timeout=120


# =============================================================================
#  بخش ۷ — فایل و Storage
# =============================================================================

FILESYSTEM_DISK=local

# فایل‌های حساس در: storage/app/private
# (موجودی، فروش، PDF، تصاویر محصول)


# =============================================================================
#  بخش ۸ — پخش رویداد (Broadcast) — فعلاً غیرفعال
# =============================================================================

BROADCAST_CONNECTION=log


# =============================================================================
#  بخش ۹ — پست الکترونیک (اختیاری)
# =============================================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@foroshgahsaz.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP واقعی (مثال):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls


# =============================================================================
#  بخش ۱۰ — Barbin: SMS.ir
# =============================================================================
#  توجه: API Key و Template ID در پنل Filament → «تنظیمات SMS.ir» ذخیره می‌شود.
#  فقط آدرس پایه API اینجا است.

SMS_IR_BASE_URL=https://api.sms.ir/v1


# =============================================================================
#  بخش ۱۱ — Barbin: پیام‌رسان روبیکا
# =============================================================================
#  توکن روبیکا در جدول messengers (encrypted) — نه در .env
#  فقط endpoint سرویس ارسال (از مستندات رسمی روبیکا):

ROUBIKA_SEND_ENDPOINT=


# =============================================================================
#  بخش ۱۲ — Barbin: پیام‌رسان بله
# =============================================================================
#  Bot Token و Channel ID در جدول messengers — از پنل ادمین / دیتابیس
#  متغیر env جداگانه لازم نیست.


# =============================================================================
#  بخش ۱۳ — Redis (اختیاری — MVP بدون Redis کار می‌کند)
# =============================================================================

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0

# اگر Queue را redis کردید:
# QUEUE_CONNECTION=redis
# REDIS_QUEUE_CONNECTION=default


# =============================================================================
#  بخش ۱۴ — AWS / S3 (اختیاری — آپلود ابری)
# =============================================================================

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=me-south-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# FILESYSTEM_DISK=s3


# =============================================================================
#  بخش ۱۵ — Frontend / Vite (اختیاری)
# =============================================================================

VITE_APP_NAME="${APP_NAME}"


# =============================================================================
#  بخش ۱۶ — پروداکشن (وقتی روی سرور واقعی می‌روید)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.ir
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache