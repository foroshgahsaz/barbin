# =============================================================================
# Barbin — نمونه تنظیمات محیط (.env)
# کپی: cp .env.example .env && php artisan key:generate
# =============================================================================

APP_NAME=Barbin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

BARBIN_FILES_DISK=barbin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# single + errorlog: اگر storage/logs قابل نوشتن نبود، لاگ به stderr/php-errorlog می‌رود
LOG_STACK=single,errorlog
# پیش‌فرض: storage/app/logs/laravel.log (قابل نوشتن روی Runflare)
# LOG_FILE_PATH=
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# دیتابیس — محلی: SQLite سریع | پروداکشن: MySQL
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=barbin
# DB_USERNAME=barbin
# DB_PASSWORD=secret

# برای SQLite (پیش‌فرض):
# touch database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue — MVP با database (بدون Redis اجباری)
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------------
# Redis (اختیاری — فقط اگر بعداً QUEUE/CACHE را redis کردید)
# -----------------------------------------------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# پست الکترونیک (اختیاری)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Barbin — یکپارچه‌سازی‌ها
# -----------------------------------------------------------------------------
# آدرس پایه API (معمولاً نیاز به تغییر ندارد)
SMS_IR_BASE_URL=https://api.sms.ir/v1

# API Key و Template ID SMS.ir در پنل Filament → «تنظیمات SMS.ir» ذخیره می‌شود
# (در دیتابیس رمزنگاری‌شده؛ داخل .env قرار ندهید مگر بخواهید بعداً override کنیم)

# روبیکا — URL رسمی ارسال که از مستندات/پنل روبیکا می‌گیرید
ROUBIKA_SEND_ENDPOINT=

# توکن بله و روبیکا در جدول messengers (پنل ادمین) ذخیره می‌شود، نه .env

# -----------------------------------------------------------------------------
# AWS / S3 (اختیاری — اگر فایل‌ها را روی S3 بگذارید)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"